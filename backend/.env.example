# ---- App security ----
APP_API_KEY=REPLACE_WITH_INTERNAL_APP_API_KEY
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Rate limiting ----
DEFAULT_RATE_LIMIT=30/minute
EXPENSIVE_ROUTE_RATE_LIMIT=10/minute
MAX_GEMINI_CALLS_PER_MINUTE=5
MAX_WEATHER_CALLS_PER_MINUTE=10

# ---- External APIs ----
GEMINI_API_KEY=REPLACE_WITH_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash

WEATHER_API_KEY=REPLACE_WITH_WEATHER_API_KEY
WEATHER_API_BASE_URL=REPLACE_WITH_WEATHER_PROVIDER_BASE_URL

# ---- Database ----
DATABASE_URL=sqlite:///./relocation.db

# ---- Cache ----
CACHE_TTL_SECONDS=600
